<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="diary.diarygoal.mapper.GoalMapper">
    <resultMap id="StageGoalResultMap" type="diary.common.entity.goal.po.StageGoalPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="category" property="category"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="SubGoalResultMap" type="diary.common.entity.goal.po.SubGoalPO">
        <id column="id" property="id"/>
        <result column="stage_id" property="stageId"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="learned_hours" property="learnedHours"/>
        <result column="estimated_hours" property="estimatedHours"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="StageGoalColumns">
        id, user_id, category, title, description, create_time, update_time
    </sql>

    <sql id="SubGoalColumns">
        id, stage_id, user_id, title, content, learned_hours, estimated_hours, create_time, update_time
    </sql>

    <insert id="insertStageGoal" parameterType="diary.common.entity.goal.po.StageGoalPO">
        INSERT INTO stage_goal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="category != null">category,</if>
            <if test="title != null">title,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="category != null">#{category},</if>
            <if test="title != null">#{title},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <select id="selectStageGoalById" resultMap="StageGoalResultMap">
        SELECT <include refid="StageGoalColumns"/>
        FROM stage_goal
        WHERE id = #{id}
    </select>

    <select id="selectSubGoalsByStageId" resultMap="SubGoalResultMap">
        SELECT <include refid="SubGoalColumns"/>
        FROM sub_goal
        WHERE stage_id = #{stageId}
        ORDER BY create_time ASC, id ASC
    </select>

    <select id="selectSubGoalsByStageIds" resultMap="SubGoalResultMap">
        SELECT <include refid="SubGoalColumns"/>
        FROM sub_goal
        WHERE
          stage_id IN
        <foreach collection="stageIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY stage_id ASC, create_time ASC, id ASC
    </select>

    <select id="selectStageGoals" resultMap="StageGoalResultMap">
        SELECT <include refid="StageGoalColumns"/>
        FROM stage_goal
        ORDER BY update_time DESC, create_time DESC, id DESC
    </select>

    <update id="updateStageGoalById" parameterType="diary.common.entity.goal.po.StageGoalPO">
        UPDATE stage_goal
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateSubGoalById" parameterType="diary.common.entity.goal.po.SubGoalPO">
        UPDATE sub_goal
        <set>
            <if test="stageId != null">stage_id = #{stageId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="learnedHours != null">learned_hours = #{learnedHours},</if>
            <if test="estimatedHours != null">estimated_hours = #{estimatedHours},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
          AND stage_id = #{stageId}
    </update>

    <update id="deleteStageGoalById">
        delete from stage_goal WHERE id = #{id}
    </update>

    <update id="deleteSubGoalsByStageId">
        delete from sub_goal WHERE stage_id = #{stageId}
    </update>

    <update id="deleteSubGoalById">
        delete from sub_goal WHERE id = #{id}
    </update>

    <select id="queryGoalData" resultMap="StageGoalResultMap">
        SELECT <include refid="StageGoalColumns"/>
        FROM stage_goal
        WHERE 1=1
        <if test="lastDays != null">
            AND update_time &gt;= DATE_SUB(NOW(), INTERVAL #{lastDays} DAY)
        </if>
        ORDER BY update_time DESC, create_time DESC, id DESC
        <if test="exportSize != null and exportSize &gt; 0">
            LIMIT #{exportSize}
        </if>
    </select>

    <insert id="batchInsertSubGoal">
        INSERT INTO sub_goal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="subGoalPOS[0].id != null">id,</if>
            <if test="subGoalPOS[0].stageId != null">stage_id,</if>
            <if test="subGoalPOS[0].userId != null">user_id,</if>
            <if test="subGoalPOS[0].title != null and subGoalPOS[0].title != ''">title,</if>
            <if test="subGoalPOS[0].content != null and subGoalPOS[0].content != ''">content,</if>
            <if test="subGoalPOS[0].learnedHours != null">learned_hours,</if>
            <if test="subGoalPOS[0].estimatedHours != null">estimated_hours,</if>
            <if test="subGoalPOS[0].createTime != null">create_time,</if>
            <if test="subGoalPOS[0].updateTime != null">update_time,</if>
        </trim>
        VALUES
        <foreach collection="subGoalPOS" item="subGoal" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="subGoal.id != null">#{subGoal.id},</if>
                <if test="subGoal.stageId != null">#{subGoal.stageId},</if>
                <if test="subGoal.userId != null">#{subGoal.userId},</if>
                <if test="subGoal.title != null and subGoal.title != ''">#{subGoal.title},</if>
                <if test="subGoal.content != null and subGoal.content != ''">#{subGoal.content},</if>
                <if test="subGoal.learnedHours != null">#{subGoal.learnedHours},</if>
                <if test="subGoal.estimatedHours != null">#{subGoal.estimatedHours},</if>
                <if test="subGoal.createTime != null">#{subGoal.createTime},</if>
                <if test="subGoal.updateTime != null">#{subGoal.updateTime},</if>
            </trim>
        </foreach>
    </insert>

    <update id="batchUpdateSubGoals">
        UPDATE sub_goal
        <trim prefix="SET" suffixOverrides=",">
            <if test="subGoalPOS[0].stageId != null">
                stage_id = CASE id
                <foreach collection="subGoalPOS" item="subGoal">
                    WHEN #{subGoal.id} THEN #{subGoal.stageId}
                </foreach>
                END,
            </if>
            <if test="subGoalPOS[0].userId != null">
                user_id = CASE id
                <foreach collection="subGoalPOS" item="subGoal">
                    WHEN #{subGoal.id} THEN #{subGoal.userId}
                </foreach>
                END,
            </if>
            <if test="subGoalPOS[0].title != null and subGoalPOS[0].title != ''">
                title = CASE id
                <foreach collection="subGoalPOS" item="subGoal">
                    WHEN #{subGoal.id} THEN #{subGoal.title}
                </foreach>
                END,
            </if>
            <if test="subGoalPOS[0].content != null and subGoalPOS[0].content != ''">
                content = CASE id
                <foreach collection="subGoalPOS" item="subGoal">
                    WHEN #{subGoal.id} THEN #{subGoal.content}
                </foreach>
                END,
            </if>
            <if test="subGoalPOS[0].learnedHours != null">
                learned_hours = CASE id
                <foreach collection="subGoalPOS" item="subGoal">
                    WHEN #{subGoal.id} THEN #{subGoal.learnedHours}
                </foreach>
                END,
            </if>
            <if test="subGoalPOS[0].estimatedHours != null">
                estimated_hours = CASE id
                <foreach collection="subGoalPOS" item="subGoal">
                    WHEN #{subGoal.id} THEN #{subGoal.estimatedHours}
                </foreach>
                END,
            </if>
            update_time = NOW()
        </trim>
        WHERE id IN
        <foreach collection="subGoalPOS" item="subGoal" open="(" separator="," close=")">
            #{subGoal.id}
        </foreach>
        AND stage_id IN
        <foreach collection="subGoalPOS" item="subGoal" open="(" separator="," close=")">
            #{subGoal.stageId}
        </foreach>
    </update>
</mapper>
