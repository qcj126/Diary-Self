<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="diary.file.mapper.ImageUploadChunkMapper">

    <resultMap id="ImageUploadChunkResultMap" type="diary.file.entity.po.ImageUploadChunkPO">
        <id property="id" column="id"/>
        <result property="uploadId" column="upload_id"/>
        <result property="chunkIndex" column="chunk_index"/>
        <result property="partNumber" column="part_number"/>
        <result property="chunkSha256" column="chunk_sha256"/>
        <result property="etag" column="etag"/>
        <result property="chunkSize" column="chunk_size"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="imageUploadChunkColumns">
        id, upload_id, chunk_index, part_number, chunk_sha256, etag,
        chunk_size, create_time, update_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO image_upload_chunk (
            upload_id, chunk_index, part_number, chunk_sha256, etag, chunk_size
        ) VALUES (
            #{uploadId}, #{chunkIndex}, #{partNumber}, #{chunkSha256}, #{etag}, #{chunkSize}
        )
    </insert>

    <select id="selectByUploadIdAndChunkIndex" resultMap="ImageUploadChunkResultMap">
        SELECT <include refid="imageUploadChunkColumns"/>
        FROM image_upload_chunk
        WHERE upload_id = #{uploadId}
          AND chunk_index = #{chunkIndex}
        LIMIT 1
    </select>

    <select id="selectByUploadIdOrderByPartNumber" resultMap="ImageUploadChunkResultMap">
        SELECT <include refid="imageUploadChunkColumns"/>
        FROM image_upload_chunk
        WHERE upload_id = #{uploadId}
        ORDER BY part_number ASC
    </select>

    <select id="countByUploadId" resultType="int">
        SELECT COUNT(*)
        FROM image_upload_chunk
        WHERE upload_id = #{uploadId}
    </select>

    <delete id="deleteByUploadId">
        DELETE FROM image_upload_chunk
        WHERE upload_id = #{uploadId}
    </delete>
</mapper>
