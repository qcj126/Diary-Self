spring:
  application:
    name: diary-file
  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_ADDR:192.168.101.128:8848}
  main:
    web-application-type: servlet
  servlet:
    multipart:
      # Spring/Tomcat 允许的单个 Multipart 文件上限
      max-file-size: 100MB
      # 整个 Multipart HTTP 请求上限，包含文件和表单边界
      max-request-size: 105MB
      # 超过多少后写入临时文件
      file-size-threshold: 256KB
server:
  port: 8802
diary:
  file:
    thumbnail:
      max-width: 480
      max-height: 480
      jpeg-quality: 0.85
      max-pixels: 40000000
    image-upload:
      chunk-size: 262144
      max-image-size: 104857600
      session-ttl-hours: 24
    part:
      part-size: 10485760 # 10MB
      file-threshold: 104857600 # 100MB
    rocketmq:
      # 用于mq的配置
      event-topic: diary-file-event
      image-uploaded-tag: IMAGE_UPLOADED
      image-ready-consumer-group: diary-file-image-ready-consumer
      # 用于outbox的配置
      publisher-batch-size: 20
      publisher-interval-ms: 10000
      outbox-sending-timeout-seconds: 60
      outbox-max-retries: 5
      outbox-clean-ms: 250000
      sent-retention-days: 7
      clean-batch-size: 500

# 使用 rocketmq-v5-client-spring-boot-starter 的正确配置
rocketmq:
  # 启用生产者, 从而触发 RocketMQClientTemplate 的自动创建
  producer:
    # 你的 NameServer 地址
    endpoints: 192.168.101.128:7081

  # 如果你有消费者, 可以类似地启用消费者
  # 但注意, 如果你使用 @RocketMQMessageListener 进行消费, 应配置 push-consumer
  push-consumer:
    endpoints: 192.168.101.128:7081