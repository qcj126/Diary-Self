<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="diary.recipe.mapper.RecipeCategoryMapper">
    <resultMap id="recipeCategoryMap" type="diary.common.entity.recipe.po.RecipeCategoryPO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="categoryNum" column="category_num"/>
        <result property="categoryIcon" column="category_icon"/>
        <result property="sort" column="sort"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="BaseColumns">
        id, user_id, category_name, category_num, category_icon, sort, create_time, update_time
    </sql>

    <select id="queryRecipeCategory" resultMap="recipeCategoryMap">
        SELECT <include refid="BaseColumns"/> FROM recipe_category
    </select>

    <select id="selectMaxCategoryNum" resultType="java.lang.Integer">
        SELECT MAX(category_num) FROM recipe_category
    </select>

    <insert id="insert" parameterType="diary.common.entity.recipe.po.RecipeCategoryPO">
        INSERT INTO recipe_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="categoryNum != null">category_num,</if>
            <if test="categoryIcon != null and categoryIcon != ''">category_icon,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="categoryNum != null">#{categoryNum},</if>
            <if test="categoryIcon != null and categoryIcon != ''">#{categoryIcon},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <delete id="deleteByIds">
        DELETE FROM recipe_category WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
