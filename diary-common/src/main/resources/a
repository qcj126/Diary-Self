mybatis:
  mapper-locations: mapper/*.xml
  configuration:
    # 使用标准日志输出
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

management:
  endpoints:
    web:
      exposure:
        include: prometheus, health, info, metrics, configprops, loggers, logfile, httptrace, threaddump, heapdump, mappings, scheduledtasks, conditions
  prometheus:
    metrics:
      export:
        enabled: true
  metrics:
    tags:
      application: ${spring.application.name}
    enable:
      tomcat: true
      tomcat.threads: true
      jvm: true
      process: true
      system: true
      logback: true
logging:
  level:
    # 或者开启整个包
    diary: DEBUG
    # SQL日志
    org.mybatis: DEBUG
    java.sql: DEBUG
    com.mysql.cj.jdbc: DEBUG
    # 如果使用MyBatis-Plus
    com.baomidou.mybatisplus: DEBUG

  # 可以指定日志输出格式（可选）
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} - %msg%n"