spring:
  application:
    name: diary-ai
  cloud:
    nacos:
      discovery:
        server-addr: 192.168.101.128:8848
    openfeign:
      client:
        config:
          # 所有 Feign Client 的保守默认值，单位毫秒
          default:
            connectTimeout: 800
            readTimeout: 2000
            loggerLevel: basic

          # 也可按服务名覆盖；名称必须与 @FeignClient(name = "...") 一致
          diary-diet:
            connectTimeout: 800
            readTimeout: 2000

          diary-recipe:
            connectTimeout: 800
            readTimeout: 2000

          diary-love:
            connectTimeout: 800
            readTimeout: 2500
  main:
    web-application-type: servlet
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 20MB

server:
  port: 8807


diary:
  ai:
    rocketmq:
      completed-tag: AI_COMPLETED
      failed-tag: AI_FAILED
      task-topic: diary-ai-task
      task-nutrient-tag: NUTRIENT_ANALYSE
      task-sentiment-tag: SENTIMENT_ANALYSIS
      ai-task-consumer-tag: "NUTRIENT_ANALYSE || SENTIMENT_ANALYSIS"
      ai-task-consumer-group: diary-ai-task-workers
      event-topic: diary-ai-event
      publisher-batch-size: 20
      publisher-interval-ms: 10000
      publisher-sending-timeout-seconds: 60
      outbox-max-retries: 5
      sent-retention-days: 7
      cleanup-batch-size: 500
    task:
      max-attempts: 3
      execution-lease-seconds: 330
      recovery-interval-ms: 10000
      recovery-batch-size: 50
    cache:
      running-ttl-seconds: 30
      terminal-ttl-hours: 24
      idempotency-ttl-hours: 24
      null-ttl-seconds: 15
      key-prefix: diary:dev:ai
    limit:
      submit-per-user-per-minute: 10
      model-local-concurrency: 5
      local-permit-wait-ms: 1000
      global-model-permit:
        # Worker 崩溃后，permit 最迟约 90 秒可被回收。
        lease-seconds: 90
        # 正常长任务每 20 秒续一次；必须明显小于 90 秒。
        renewal-interval-seconds: 20
        # 模型名额满时，延迟重投的基础等待时间。
        capacity-retry-delay-seconds: 10
        # Redis 故障时更保守地等待，优先保护供应商配额。
        redis-unavailable-retry-delay-seconds: 30
        models:
          QWEN37PLUS:
            max-concurrency: 5
          DEEPSEEKV4PRO0813:
            max-concurrency: 10
    metrics:
      # 将数据库状态快照写入内存 Gauge 的间隔；Prometheus 抓取时不会额外查询数据库。
      snapshot-interval-ms: 15000

# 使用 rocketmq-v5-client-spring-boot-starter 的正确配置
rocketmq:
  # 启用生产者, 从而触发 RocketMQClientTemplate 的自动创建
  producer:
    # 你的 NameServer 地址
    endpoints: 192.168.101.128:7081

  # 如果你有消费者, 可以类似地启用消费者
  # 但注意, 如果你使用 @RocketMQMessageListener 进行消费, 应配置 push-consumer
  push-consumer:
    endpoints: 192.168.101.128:7081

  ali-cloud:
    api:
      api-key:
      url: h
      deepSeekV4ProModel: deepseek-v4-pro-0813
      qwenPlusModel: qwen3.7-plus
      qwenMaxModel: qwen3.7-max
      temperature: 0.7

# Prometheus 从 /actuator/prometheus 抓取指标；健康端点用于负载均衡和容器探针。
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus,metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: never
      group:
        # AI 任务依赖 MySQL 持久化和 Redis 限流；任一不可用时不应继续接收流量。
        readiness:
          include: readinessState,db,redis
  health:
    livenessstate:
      enabled: true
    readinessstate:
      enabled: true
  metrics:
    tags:
      application: ${spring.application.name:diary-ai}
