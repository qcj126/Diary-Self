<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="diary.diaryai.mapper.AiNutrientQueryMapper">

    <resultMap id="AiNutrientResultMap" type="diary.diaryai.entity.ai.po.AiNutrientPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="universal_id" property="universalId"/>
        <result column="ai_info_id" property="aiInfoId"/>
        <result column="ai_task_id" property="aiTaskId"/>
        <result column="calory" property="calory"/>
        <result column="protein" property="protein"/>
        <result column="fat" property="fat"/>
        <result column="carbohydrate" property="carbohydrate"/>
        <result column="sugar" property="sugar"/>
        <result column="sodium" property="sodium"/>
        <result column="flag" property="flag"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectLatestDietNutrients" resultMap="AiNutrientResultMap">
        SELECT n.id, n.user_id, n.universal_id, n.ai_info_id, n.ai_task_id,
               n.calory, n.protein, n.fat, n.carbohydrate, n.sugar, n.sodium,
               n.flag, n.create_time, n.update_time
        FROM ai_nutrient n
        WHERE n.user_id = #{userId}
          AND n.flag = 'DIET'
          AND n.universal_id IN
          <foreach collection="dietIds" item="dietId" open="(" separator="," close=")">
              #{dietId}
          </foreach>
          AND NOT EXISTS (
              SELECT 1
              FROM ai_nutrient newer
              WHERE newer.user_id = n.user_id
                AND newer.flag = 'DIET'
                AND newer.universal_id = n.universal_id
                AND (
                    newer.create_time &gt; n.create_time
                    OR (newer.create_time = n.create_time AND newer.id &gt; n.id)
                )
          )
    </select>
</mapper>
