        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="model" property="model" jdbcType="VARCHAR"/>
        <result column="temperature" property="temperature" jdbcType="VARCHAR"/>
        <result column="ai_type" property="aiType" jdbcType="TINYINT"/>
        <result column="ai_application" property="aiApplication" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <resultMap id="AiNutrientResultMap" type="diary.common.entity.ai.po.AiNutrientPO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="universal_id" property="universalId" jdbcType="BIGINT"/>
        <result column="ai_info_id" property="aiInfoId" jdbcType="BIGINT"/>
        <result column="calory" property="calory" jdbcType="VARCHAR"/>
        <result column="protein" property="protein" jdbcType="VARCHAR"/>
        <result column="fat" property="fat" jdbcType="VARCHAR"/>
        <result column="carbohydrate" property="carbohydrate" jdbcType="VARCHAR"/>
        <result column="sugar" property="sugar" jdbcType="VARCHAR"/>
        <result column="sodium" property="sodium" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insertAiNutrient">
        INSERT INTO ai_nutrient (id, user_id, universal_id, flag, ai_info_id, calory, protein, fat, carbohydrate, sugar, sodium)
        VALUES (#{id}, #{userId}, #{universalId}, #{flag}, #{aiInfoId}, #{calory}, #{protein}, #{fat}, #{carbohydrate}, #{sugar}, #{sodium})
    </insert>

    <insert id="insertAiInfo">
        insert into ai_info(id, user_id, model, temperature, ai_type, ai_application)
        values (#{id}, #{userId}, #{model}, #{temperature}, #{aiType}, #{aiApplication})
    </insert>

    <update id="updateAiTaskStatus" parameterType="diary.common.entity.ai.dto.AiTaskProcessDto">
        UPDATE ai_task
        <set>
            <if test="userId != null">user_id = #{userId, jdbcType=BIGINT},</if>
            <if test="clientRequestId != null and clientRequestId != ''">client_request_id = #{clientRequestId, jdbcType=VARCHAR},</if>
            <if test="taskType != null and taskType != ''">task_type = #{taskType, jdbcType=VARCHAR},</if>
            <if test="status != null and status != ''">status = #{status, jdbcType=VARCHAR},</if>
            <if test="inputSnapshot != null and inputSnapshot != ''">input_snapshot = #{inputSnapshot, jdbcType=VARCHAR},</if>
            <if test="attemptCount != null">attempt_count = #{attemptCount, jdbcType=INTEGER},</if>
            <if test="maxAttempts != null">max_attempts = #{maxAttempts, jdbcType=INTEGER},</if>
            <if test="workerId != null and workerId != ''">worker_id = #{workerId, jdbcType=VARCHAR},</if>
            <if test="leaseUntil != null">lease_until = #{leaseUntil, jdbcType=TIMESTAMP},</if>
            <if test="aiInfoId != null">ai_info_id = #{aiInfoId, jdbcType=BIGINT},</if>
            <if test="errorCode != null and errorCode != ''">error_code = #{errorCode, jdbcType=VARCHAR},</if>
            <if test="errorMessage != null and errorMessage != ''">error_message = #{errorMessage, jdbcType=VARCHAR},</if>
            <if test="createTime != null">create_time = #{createTime, jdbcType=TIMESTAMP},</if>
            <if test="queueTime != null">queue_time = #{queueTime, jdbcType=TIMESTAMP},</if>
            <if test="startTime != null">start_time = #{startTime, jdbcType=TIMESTAMP},</if>
            <if test="finishTime != null">finish_time = #{finishTime, jdbcType=TIMESTAMP},</if>
            <if test="versionId != null">version_id = #{versionId, jdbcType=INTEGER},</if>
        </set>
        WHERE id = #{taskId} and user_id = #{userId} and client_request_id = #{clientRequestId} and max_attempts > #{attemptCount}
    </update>

    <insert id="insertAiTask" parameterType="diary.common.entity.ai.po.AiTaskPO">
            INSERT INTO ai_task
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">
                    id,
                </if>
                <if test="userId != null">
                    user_id,
                </if>
                <if test="clientRequestId != null and clientRequestId != ''">
                    client_request_id,
                </if>
                <if test="taskType != null and taskType != ''">
                    task_type,
                </if>
                <if test="status != null and status != ''">
