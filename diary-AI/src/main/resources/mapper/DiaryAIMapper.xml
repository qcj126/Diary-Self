                <if test="startTime != null">
                    start_time,
                </if>
                <if test="finishTime != null">
                    finish_time,
                </if>
                <if test="versionId != null">
                    version_id,
                </if>
            </trim>
            VALUES
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="taskId != null">
                    #{id},
                </if>
                <if test="userId != null">
                    #{userId, jdbcType=BIGINT},
                </if>
                <if test="clientRequestId != null and clientRequestId != ''">
                    #{clientRequestId, jdbcType=VARCHAR},
                </if>
                <if test="taskType != null and taskType != ''">
                    #{taskType, jdbcType=VARCHAR},
                </if>
                <if test="status != null and status != ''">
                    #{status, jdbcType=VARCHAR},
                </if>
                <if test="inputSnapshot != null and inputSnapshot != ''">
                    #{inputSnapshot, jdbcType=VARCHAR},
                </if>
                <if test="attemptCount != null">
                    #{attemptCount, jdbcType=INTEGER},
                </if>
                <if test="maxAttempts != null">
                    #{maxAttempts, jdbcType=INTEGER},
                </if>
                <if test="workerId != null and workerId != ''">
                    #{workerId, jdbcType=VARCHAR},
                </if>
                <if test="leaseUntil != null">
                    #{leaseUntil, jdbcType=TIMESTAMP},
                </if>
                <if test="aiInfoId != null">
                    #{aiInfoId, jdbcType=BIGINT},
                </if>
                <if test="errorCode != null and errorCode != ''">
