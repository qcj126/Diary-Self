                </if>
                <if test="inputSnapshot != null and inputSnapshot != ''">
                    input_snapshot,
                </if>
                <if test="attemptCount != null">
                    attempt_count,
                </if>
                <if test="maxAttempts != null">
                    max_attempts,
                </if>
                <if test="workerId != null and workerId != ''">
                    worker_id,
                </if>
                <if test="leaseUntil != null">
                    lease_until,
                </if>
                <if test="aiInfoId != null">
                    ai_info_id,
                </if>
                <if test="errorCode != null and errorCode != ''">
                    error_code,
                </if>
                <if test="errorMessage != null and errorMessage != ''">
