spring:
  application:
    name: diary-gateway
  cloud:
    nacos:
      discovery:
        server-addr: 192.168.101.128:8848
    gateway:
      server:
        webflux:
          discovery:
            locator:
              enabled: true
              lower-case-service-id: true
          routes:
            - id: diary-user
              uri: lb://diary-user
              predicates:
                - Path=/user/**
            - id: diary-file
              uri: lb://diary-file
              predicates:
                - Path=/file/**
            - id: diary-recipe
              uri: lb://diary-recipe
              predicates:
                - Path=/recipe/**
            - id: diary-timemachine
              uri: lb://diary-timemachine
              predicates:
                - Path=/time-machine/**
            - id: diary-diet
              uri: lb://diary-diet
              predicates:
                - Path=/diet/**
            - id: diary-goal
              uri: lb://diary-goal
              predicates:
                - Path=/goal/**
            - id: diary-ai
              uri: lb://diary-ai
              predicates:
                - Path=/ai/**
            - id: diary-sysInfo
              uri: lb://diary-sysInfo
              predicates:
                - Path=/sys/info/**
            - id: diary-love
              uri: lb://diary-love
              predicates:
                - Path=/love/**
          globalcors:
            corsConfigurations:
              '[/**]':
                allowedOriginPatterns: "http://localhost:1025"
                allowedMethods:
                  - GET
                  - POST
                  - PUT
                  - DELETE
                  - OPTIONS
                allowedHeaders: "*"
                allowCredentials: true

  http:
    codecs:
      max-in-memory-size: 20MB
  main:
    web-application-type: reactive
server:
  port: 10000

gateway:
  auth:
    exclude-paths:
      - /user/login
      - /user/refresh
      - /user/register
      - /user/verifycode
      - /user/resetPw
      - /file/download/image
      - /file/icon/**
      - /sys/info/**
      - /actuator/**
      - /favicon.ico
# JWT configuration
jwt:
  secret: your256bitsecretkeymustbeatleast32characterslong
  access-token-expiration: 600000 # accessToken 10分钟
  refresh-token-expiration: 21600000 # refreshToken 6小时
